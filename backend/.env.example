# ============================================================
# APPLICATION / SESSION
# ============================================================
APP_NAME=Laravel
# local|production|testing
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

OCTANE_SERVER=frankenphp

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ============================================================
# DATABASE
# ============================================================
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=!ChangeMe!
# DB_USERNAME=!ChangeMe!
# DB_PASSWORD=!ChangeMe!

# These needed for other pods like cron, queue, so on
POSTGRES_DB=!ChangeMe!
POSTGRES_USER=!ChangeMe!
POSTGRES_PASSWORD=!ChangeMe!

# ============================================================
# APPLICATION SERVICES
# ============================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ============================================================
# REDIS
# ============================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================
# MAIL
# ============================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_ADMIN_ADDRESS="hello@example.com"
MAIL_ADMIN_NAME="Store Admin"

# ============================================================
# ADMIN
# ============================================================
SUPER_ADMIN_EMAIL=!ChangeMe!
SUPER_ADMIN_PASSWORD=!ChangeMe!

# ============================================================
# CJ
# ============================================================
CJ_API_KEY=!changeMe!
DS_SANDBOX=1

# ============================================================
# GOOGLE
# ============================================================
GOOGLE_CLIENT_ID=!changeMe!
GOOGLE_CLIENT_SECRET=!changeMe!
GOOGLE_REDIRECT_URI=http://localhost:8000/api/customer/auth/google/callback

# ============================================================
# PAYMENTS
# ============================================================
WFP_MERCHANT_ACCOUNT=!changeMe!
WFP_MERCHANT_SECRET=!changeMe!
WFP_RETURN_URL=!changeMe!
WFP_SERVICE_URL=!changeMe!

LIQPAY_PUBLIC_KEY=!changeMe!
LIQPAY_PRIVATE_KEY=!changeMe!
LIQPAY_RETURN_URL=!changeMe!
LIQPAY_SERVER_URL=!changeMe!
